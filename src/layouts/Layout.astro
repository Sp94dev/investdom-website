---
import "@fontsource/montserrat/700.css";
import "@fontsource/inter/400.css";
import "@fontsource/inter/500.css";
import "../styles/global.css";
import { getCanonicalUrl, getBusinessSchema, serializeJsonLd } from "../lib/seo.mjs";
import { company } from "../data/company.mjs";
import { getMarkdownPath } from "../lib/agent-representation.mjs";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  structuredData?: Record<string, unknown>[];
}

const site = Astro.site;
if (!site) throw new Error("The canonical site URL must be configured in Astro.");
const siteUrl = site.origin;
const {
  title = "INVESTDOM - Budowa Domów Bielsko-Biała",
  description = "Budujemy domy w Bielsku-Białej. Solidność, osobisty nadzór właściciela. Stan surowy, deweloperski, pod klucz.",
  ogImage = "/og-image.jpg",
  structuredData = [],
} = Astro.props;

const canonicalUrl = getCanonicalUrl(Astro.url.pathname, site);
const markdownPath = getMarkdownPath(Astro.url.pathname);
---

<!doctype html>
<html lang="pl" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    {markdownPath && (
      <>
        <link rel="alternate" type="text/markdown" href={markdownPath} />
        <link rel="describedby" type="text/markdown" href="/agent-guide.md" />
        <link rel="ai-catalog" type="application/json" href="/.well-known/ai-catalog.json" />
      </>
    )}

    <!-- SEO Meta Tags -->
    <meta
      name="robots"
      content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
    />
    <meta name="googlebot" content="index, follow" />
    <meta name="bingbot" content="index, follow" />
    <meta name="author" content="INVESTDOM" />
    <meta name="publisher" content="INVESTDOM" />
    <meta name="copyright" content="INVESTDOM" />
    <meta name="revisit-after" content="7 days" />
    <meta name="rating" content="general" />
    <meta name="distribution" content="global" />
    <meta name="coverage" content="Poland" />
    <meta name="language" content="Polish" />
    <meta
      name="category"
      content="Budownictwo, Nieruchomości, Usługi budowlane"
    />
    <meta name="classification" content="Business" />
    <meta name="subject" content="Budowa domów jednorodzinnych Bielsko-Biała" />
    <meta
      name="topic"
      content="Budowa domów, domy pod klucz, firma budowlana"
    />
    <meta name="summary" content={description} />
    <meta
      name="keywords"
      content="budowa domów, domy Bielsko-Biała, budowa domu Bielsko-Biała, sprzedaż domów, domy pod klucz, stan surowy, stan deweloperski, generalny wykonawca, powiat bielski, powiat cieszyński, powiat żywiecki, Czechowice-Dziedzice, Żywiec, Cieszyn, Wisła, Ustroń, Szczyrk, domy jednorodzinne, budowa domu jednorodzinnego, firma budowlana Bielsko-Biała, ekipa budowlana, domy na sprzedaż, nowe domy, inwestycje mieszkaniowe, działki budowlane, projekty domów, budownictwo mieszkaniowe, usługi budowlane, wykonawca budowlany, budowa fundamentów, budowa dachu, wykończenia wnętrz, stan zero, budowa murów, izolacje, ocieplenie domu"
    />

    <!-- Geo Meta Tags -->
    <meta name="geo.region" content="PL-24" />
    <meta name="geo.placename" content="Bielsko-Biała" />

    <!-- Dublin Core Meta Tags -->
    <meta name="DC.title" content={title} />
    <meta name="DC.creator" content="INVESTDOM" />
    <meta name="DC.subject" content="Budowa domów jednorodzinnych" />
    <meta name="DC.description" content={description} />
    <meta name="DC.publisher" content="INVESTDOM" />
    <meta name="DC.language" content="pl" />
    <meta name="DC.coverage" content="Bielsko-Biała, Polska" />
    <meta name="DC.rights" content="Copyright INVESTDOM" />

    <!-- Contact Meta Tags -->
    <meta name="contact" content={company.email} />
    <meta name="reply-to" content={company.email} />

    <!-- Verification & Other -->
    <meta name="format-detection" content="telephone=yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="INVESTDOM" />
    <meta name="application-name" content="INVESTDOM" />
    <meta name="theme-color" content="#1e3a5f" />
    <meta name="msapplication-TileColor" content="#1e3a5f" />

    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${siteUrl}${ogImage}`} />
    <meta property="og:image:width" content="1024" />
    <meta property="og:image:height" content="1024" />
    <meta
      property="og:image:alt"
      content="INVESTDOM - Budowa Domów Bielsko-Biała"
    />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:site_name" content="INVESTDOM" />
    <meta property="og:see_also" content={`${siteUrl}/`} />

    <!-- Business Open Graph -->
    <meta
      property="business:contact_data:street_address"
      content={company.address.streetAddress}
    />
    <meta property="business:contact_data:locality" content={company.address.addressLocality} />
    <meta property="business:contact_data:postal_code" content={company.address.postalCode} />
    <meta property="business:contact_data:country_name" content="Polska" />
    <meta
      property="business:contact_data:phone_number"
      content={company.telephone}
    />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}${ogImage}`} />
    <meta
      name="twitter:image:alt"
      content="INVESTDOM - Budowa Domów Bielsko-Biała"
    />

    <!-- Schema.org: rendered with the page, using only verified site data. -->
    {[getBusinessSchema(site), ...structuredData].map((schema) => (
      <script type="application/ld+json" is:inline set:html={serializeJsonLd(schema)} />
    ))}

    <!-- Google Analytics (via Partytown) -->
    <script
      type="text/partytown"
      src="https://www.googletagmanager.com/gtag/js?id=G-XDW3BJ5BJ9"></script>
    <script type="text/partytown">
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", "G-XDW3BJ5BJ9");
    </script>
  </head>
  <body
    class="font-sans text-slate-800 bg-stone-50 antialiased selection:bg-navy-900 selection:text-white"
  >
    <slot />
  </body>
</html>
