---
import Container from "../ui/Container.astro";

const faqs = [
  {
    question: "Ile kosztuje budowa domu w Bielsku-Białej?",
    answer:
      "Koszt zależy od projektu, wielkości domu i zakresu prac. Prześlij nam projekt i podaj lokalizację działki. Przygotujemy wycenę dla Twojej budowy.",
  },
  {
    question: "Czy budujecie domy na działce klienta?",
    answer:
      "Tak. Budujemy na działkach klientów w Bielsku-Białej i okolicach, m.in. w Czechowicach-Dziedzicach, Żywcu, Szczyrku i Cieszynie. Możesz zlecić nam stan surowy, deweloperski lub budowę pod klucz.",
  },
  {
    question: "Ile trwa budowa domu pod klucz?",
    answer:
      "Termin ustalamy po omówieniu projektu i zakresu prac. Na czas budowy wpływają m.in. wielkość domu, technologia oraz pogoda. Skontaktuj się z nami, żeby omówić harmonogram Twojej budowy.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: faq.answer,
    },
  })),
};
---

<section class="py-20 bg-stone-50 border-t border-stone-200">
  <Container>
    <div class="max-w-3xl mx-auto">
      <div class="text-center mb-12">
        <span
          class="inline-block px-4 py-2 bg-navy-900/10 text-navy-900 text-sm font-medium rounded-full mb-4"
          >FAQ</span
        >
        <h2
          class="font-heading font-bold text-3xl md:text-4xl text-navy-900 mb-6"
        >
          Pytania o budowę domu
        </h2>
      </div>

      <div class="space-y-6">
        {
          faqs.map((faq, index) => (
            <div class="bg-white rounded-2xl p-6 md:p-8 shadow-sm border border-stone-100">
              <h3 class="font-bold text-xl text-navy-900 mb-4">
                {faq.question}
              </h3>
              <p class="text-slate-600 leading-relaxed">{faq.answer}</p>
            </div>
          ))
        }
      </div>
    </div>
  </Container>

  <!-- FAQ Schema -->
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</section>
