---
import Container from "../ui/Container.astro";
import Logo from "../brand/Logo.astro";
import { company } from "../../data/company.mjs";

const currentYear = new Date().getFullYear();
---

<footer class="bg-navy-900 text-stone-100 py-12 border-t border-navy-800">
  <Container>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-8 mb-8">
      <div class="col-span-1 md:col-span-2 lg:col-span-2">
        <div class="mb-4 bg-stone-50 p-2 inline-block rounded max-w-[200px]">
          <Logo />
        </div>
        <p class="text-stone-300 max-w-sm">
          Budujemy domy jednorodzinne w Bielsku-Białej i okolicach.
          Prowadzimy też własną inwestycję w Pisarzowicach.
        </p>
      </div>
      <div>
        <h3 class="font-heading font-bold text-lg mb-4">Kontakt</h3>
        <ul class="space-y-2 text-stone-300">
          <li>{company.address.streetAddress}</li>
          <li>{company.address.postalCode} {company.address.addressLocality}</li>
          <li>
            <a
              href={`tel:${company.telephone}`}
              data-astro-reload
              class="hover:text-white transition-colors">{company.telephoneDisplay}</a
            >
          </li>
          <li>
            <a
              href={`mailto:${company.email}`}
              data-astro-reload
              class="hover:text-white transition-colors">{company.email}</a
            >
          </li>
        </ul>
      </div>
      <div>
        <h3 class="font-heading font-bold text-lg mb-4">Nawigacja</h3>
        <ul class="space-y-2 text-stone-300">
          <li>
            <a href="/#o-firmie" class="hover:text-white transition-colors"
              >O firmie</a
            >
          </li>
          <li>
            <a
              href="/domy-na-sprzedaz-bielsko"
              class="hover:text-white transition-colors">Domy na sprzedaż</a
            >
          </li>
          <li>
            <a href="/#uslugi" class="hover:text-white transition-colors"
              >Usługi budowlane</a
            >
          </li>
          <li>
            <a href="/#kontakt" class="hover:text-white transition-colors"
              >Kontakt</a
            >
          </li>
        </ul>
      </div>
      <div>
        <h3 class="font-heading font-bold text-lg mb-4">Gdzie budujemy?</h3>
        <ul class="space-y-2 text-stone-300">
          <li>Bielsko-Biała</li>
          <li>Hałcnów</li>
          <li>Komorowice</li>
          <li>Szczyrk</li>
          <li>Żywiec</li>
          <li>Czechowice-Dziedzice</li>
        </ul>
      </div>
    </div>
    <div
      class="pt-8 border-t border-navy-800 text-center text-stone-300 text-sm"
    >
      <p>&copy; {currentYear} INVESTDOM. Wszelkie prawa zastrzeżone.</p>
    </div>
  </Container>
</footer>
