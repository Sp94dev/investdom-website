---
export const prerender = true;

import Layout from "../layouts/Layout.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import Container from "../components/ui/Container.astro";
import Button from "../components/ui/Button.astro";
import { Picture } from "astro:assets";
import { properties } from "../data/properties";
import { getServiceSchema } from "../lib/seo.mjs";

if (!Astro.site) throw new Error("The canonical site URL must be configured in Astro.");
const property = properties[0];
const photos = property.gallery.slice(0, 2);
---

<Layout
  title="Budowa domów Bielsko-Biała i okolice | Pod klucz | INVESTDOM"
  description="Budowa domów w Bielsku-Białej i okolicach: stan surowy, deweloperski i pod klucz. Zobacz dom w Pisarzowicach i zapytaj INVESTDOM o wycenę swojego projektu."
  structuredData={[getServiceSchema(Astro.site)]}
>
  <Header />
  <main class="pt-32 pb-16 bg-stone-50 min-h-screen">
    <Container>
      <div class="max-w-5xl mx-auto space-y-12">
        <section class="bg-white p-6 md:p-12 rounded-3xl shadow-xl border border-stone-100" aria-labelledby="service-title">
          <span class="inline-block px-4 py-2 bg-navy-900/10 text-navy-900 text-sm font-medium rounded-full mb-6">Budowa domu z INVESTDOM</span>
          <h1 id="service-title" class="font-heading font-bold text-4xl md:text-5xl text-navy-900 mb-6 leading-tight">
            Budowa domów w Bielsku-Białej i okolicach
          </h1>
          <p class="text-lg text-slate-600 mb-8 max-w-3xl">
            Budujemy domy jednorodzinne w Bielsku-Białej i okolicach. Ustalamy zakres
            współpracy dla Twojego projektu: stan surowy, deweloperski lub budowa pod klucz.
          </p>
          <Button href="/#kontakt">Zapytaj o wycenę</Button>
        </section>

        <section aria-labelledby="scope-title">
          <h2 id="scope-title" class="font-heading font-bold text-3xl text-navy-900 mb-6">Wybierz zakres budowy</h2>
          <div class="grid md:grid-cols-3 gap-6">
            <div class="bg-white p-6 rounded-2xl border border-stone-200">
              <h3 class="font-bold text-xl text-navy-900 mb-3">Stan surowy</h3>
              <p class="text-slate-600">Od prac ziemnych i fundamentów przez ściany i stropy po konstrukcję i pokrycie dachu.</p>
            </div>
            <div class="bg-white p-6 rounded-2xl border border-stone-200">
              <h3 class="font-bold text-xl text-navy-900 mb-3">Stan deweloperski</h3>
              <p class="text-slate-600">Przygotowanie domu do wykończenia: stolarka, instalacje, tynki, wylewki i elewacja — w uzgodnionym zakresie.</p>
            </div>
            <div class="bg-white p-6 rounded-2xl border border-stone-200">
              <h3 class="font-bold text-xl text-navy-900 mb-3">Budowa pod klucz</h3>
              <p class="text-slate-600">Budowa wraz z wykończeniem wnętrz. Zakres prac i wybór materiałów ustalamy indywidualnie dla projektu.</p>
            </div>
          </div>
        </section>

        <section class="bg-white p-6 md:p-10 rounded-3xl border border-stone-200" aria-labelledby="cooperation-title">
          <h2 id="cooperation-title" class="font-heading font-bold text-3xl text-navy-900 mb-6">Od projektu do ustalenia prac</h2>
          <ol class="list-decimal pl-6 space-y-3 text-slate-600">
            <li>Przekaż nam lokalizację działki, projekt i oczekiwany etap wykończenia.</li>
            <li>Omówimy zakres budowy i rozwiązania dla Twojego domu.</li>
            <li>Na tej podstawie ustalimy wycenę oraz warunki współpracy.</li>
          </ol>
          <p class="mt-6 text-slate-600">Jeśli szukasz inspiracji, zobacz <a href="/projekty-domow" class="text-navy-900 underline underline-offset-4">prezentowany projekt domu</a>.</p>
        </section>

        <section aria-labelledby="example-title">
          <h2 id="example-title" class="font-heading font-bold text-3xl text-navy-900 mb-4">Zobacz dom w Pisarzowicach</h2>
          <p class="text-slate-600 mb-6">Dom z naszej inwestycji koło Bielska-Białej. Zdjęcia pokazują budynek na różnych etapach przygotowania otoczenia.</p>
          <div class="grid md:grid-cols-2 gap-6 mb-6">
            {photos.map((photo, index) => (
              <figure class="bg-white rounded-2xl overflow-hidden border border-stone-200">
                <Picture src={photo.image} alt={photo.alt} widths={[400, 640, 960, 1440]} sizes="(min-width: 1024px) 500px, (min-width: 768px) 45vw, 100vw" formats={["avif", "webp"]} fallbackFormat="webp" quality={65} loading={index === 0 ? "eager" : "lazy"} fetchpriority={index === 0 ? "high" : "auto"} class="w-full aspect-[4/3] object-cover" />
                <figcaption class="p-4 text-sm text-slate-600">{photo.caption}</figcaption>
              </figure>
            ))}
          </div>
          <div class="flex flex-wrap gap-4">
            <Button href={property.href} variant="outline">Poznaj inwestycję w Pisarzowicach</Button>
            <Button href="/#kontakt">Zapytaj o wycenę</Button>
          </div>
        </section>
      </div>
    </Container>
  </main>
  <Footer />
</Layout>
