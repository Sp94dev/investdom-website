---
export const prerender = true;

import Layout from "../layouts/Layout.astro";
import PropertySpecs from "../components/ui/PropertySpecs.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import Container from "../components/ui/Container.astro";
import Button from "../components/ui/Button.astro";
import PhotoCaption from "../components/ui/PhotoCaption.astro";
import { Picture } from "astro:assets";
import { propertyLocations as districts } from "../data/properties";
---

<Layout
  title="Domy na sprzedaż Bielsko-Biała i okolice | INVESTDOM"
  description="Dom na sprzedaż w Pisarzowicach koło Bielska-Białej. Etap II inwestycji INVESTDOM w trakcie realizacji. Poznaj ofertę i skontaktuj się z nami."
>
  <Header />
  <main class="pt-32 pb-16 bg-stone-50 min-h-screen">
    <Container>
      <div class="text-center max-w-3xl mx-auto mb-16">
        <span
          class="inline-block px-4 py-2 bg-navy-900/10 text-navy-900 text-sm font-medium rounded-full mb-4"
          >Oferta deweloperska</span
        >
        <h1
          class="font-heading font-bold text-4xl md:text-5xl text-navy-900 mb-6"
        >
          Domy na sprzedaż w Bielsku-Białej i okolicach
        </h1>
        <p class="text-lg text-slate-600">
          Obecnie mamy na sprzedaż dom w Pisarzowicach koło Bielska-Białej.
        </p>
      </div>

      <div class="space-y-16">
        {
          districts.map((district, districtIndex) => (
            <div>
              <h2 class="text-3xl font-bold text-navy-900 mb-8 border-b border-stone-200 pb-4">
                {district.name}
              </h2>

              <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
                {district.offers.map((offer, offerIndex) => (
                  <div class="bg-white rounded-3xl overflow-hidden shadow-lg border border-stone-100 flex flex-col">
                    <div class="relative h-64">
                      <Picture
                        src={offer.image}
                        alt={offer.imageAlt}
                        class="absolute inset-0 w-full h-full object-cover object-[75%_center]"
                        pictureAttributes={{ class: "contents" }}
                        width={800}
                        height={450}
                        widths={[400, 640, 800, 1200, 1600]}
                        sizes="(min-width: 1280px) 592px, (min-width: 1024px) max(calc((100vw - 96px) / 2), 456px), (min-width: 640px) calc(100vw - 48px), max(calc(100vw - 32px), 456px)"
                        formats={["avif", "webp"]}
                        fallbackFormat="webp"
                        quality={45}
                        loading={districtIndex === 0 && offerIndex === 0 ? "eager" : "lazy"}
                        fetchpriority={districtIndex === 0 && offerIndex === 0 ? "high" : "auto"}
                        decoding="async"
                      />
                      <div class="absolute top-4 left-4">
                        <span class="px-3 py-1 bg-green-700 text-white text-xs font-bold rounded-full shadow-lg uppercase tracking-wide">
                          {offer.status}
                        </span>
                      </div>
                      <PhotoCaption />
                    </div>

                    <div class="p-8 flex flex-col flex-grow">
                      <h3 class="font-bold text-2xl text-navy-900 mb-4">
                        {offer.title}
                      </h3>
                      <p class="text-sm font-medium text-navy-900 mb-4">{offer.stage}</p>

                      <PropertySpecs size={offer.size} plot={offer.plot} />

                      <div class="mb-6 mt-2">
                        {offer.description && (
                          <div class="text-slate-600 text-sm leading-relaxed space-y-3">
                            {offer.description
                              .split("\n\n")
                              .map((paragraph) => (
                                <p>{paragraph}</p>
                              ))}
                          </div>
                        )}
                      </div>

                      <div class="flex flex-wrap gap-2 mb-8">
                        {offer.features.map((feat) => (
                          <span class="px-3 py-1 bg-navy-50 text-navy-900 text-sm rounded-full border border-navy-100">
                            {feat}
                          </span>
                        ))}
                      </div>

                      <div class="mt-auto flex flex-wrap gap-4 items-center justify-between pt-6 border-t border-stone-100">
                        <div>
                          <span class="block text-slate-500 text-sm">
                            Cena:
                          </span>
                          <span class="font-bold text-2xl text-navy-900">
                            {offer.price}
                          </span>
                        </div>
                        <Button href={offer.href} variant="primary">
                          Zobacz szczegóły domu
                        </Button>
                      </div>
                    </div>
                  </div>
                ))}
              </div>
              {district.offers.length === 0 && (
                <p class="text-slate-500 italic">
                  Brak wolnych domów w tej lokalizacji. Zapytaj o nadchodzące
                  inwestycje.
                </p>
              )}
            </div>
          ))
        }
      </div>
    </Container>
  </main>
  <Footer />
</Layout>
