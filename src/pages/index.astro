---
export const prerender = true;

import Layout from "../layouts/Layout.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import Hero from "../components/sections/Hero.astro";
import About from "../components/sections/About.astro";
import Properties from "../components/sections/Properties.astro";
import Services from "../components/sections/Services.astro";
import Contact from "../components/sections/Contact.astro";
import FAQ from "../components/sections/FAQ.astro";
---

<Layout
  title="Budowa domów Bielsko-Biała | Domy na sprzedaż | INVESTDOM"
  description="INVESTDOM: budowa domów w Bielsku-Białej i okolicach. Stan surowy, deweloperski i pod klucz. Sprawdź też dom na sprzedaż w Pisarzowicach."
>
  <Header />
  <main>
    <Hero />
    <About />
    <Properties />
    <Services />
    <FAQ />
    <Contact />
  </main>
  <Footer />
</Layout>
