---
export const prerender = true;

import Layout from "../layouts/Layout.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import Container from "../components/ui/Container.astro";
import PhotoCaption from "../components/ui/PhotoCaption.astro";
import { Picture } from "astro:assets";
import { properties as projects } from "../data/properties";
---

<Layout
  title="Projekty Domów Bielsko-Biała | Autorskie Projekty | INVESTDOM"
  description="Poznaj projekt domu prezentowany przez INVESTDOM: powierzchnię, liczbę pokoi i łazienek. Zapytaj o realizację w Bielsku-Białej i okolicach."
>
  <Header />
  <main class="pt-32 pb-16 bg-white min-h-screen">
    <Container>
      <div class="text-center max-w-3xl mx-auto mb-16">
        <span
          class="inline-block px-4 py-2 bg-navy-900/10 text-navy-900 text-sm font-medium rounded-full mb-4"
          >Nasze projekty</span
        >
        <h1
          class="font-heading font-bold text-4xl md:text-5xl text-navy-900 mb-6"
        >
          Autorskie Projekty Domów
        </h1>
        <p class="text-lg text-slate-600">
          Wybraliśmy i zoptymalizowaliśmy projekty domów jednorodzinnych, które
          idealnie wpisują się w potrzeby nowoczesnej rodziny oraz uwarunkowania
          terenowe Śląska i Podbeskidzia.
        </p>
      </div>

      <div
        class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6"
      >
        {
          projects.map((project, index) => (
            <div class="bg-stone-50 rounded-2xl overflow-hidden border border-stone-100 hover:shadow-xl transition-all duration-300 group cursor-pointer">
              <div class="relative h-48 overflow-hidden bg-white flex items-center justify-center p-4">
                <Picture
                  src={project.image}
                  alt={`${project.imageAlt} — ilustracja projektu`}
                  class="w-full h-full object-cover object-[75%_center] rounded-xl group-hover:scale-105 transition-transform duration-500"
                  pictureAttributes={{ class: "contents" }}
                  width={400}
                  height={225}
                  widths={[400, 640, 800, 1200]}
                  sizes="(min-width: 1280px) 254px, (min-width: 1024px) calc((100vw - 112px) / 3 - 32px), (min-width: 768px) calc((100vw - 72px) / 2 - 32px), (min-width: 640px) calc(100vw - 80px), calc(100vw - 64px)"
                  formats={["avif", "webp"]}
                  fallbackFormat="webp"
                  quality={45}
                  loading={index === 0 ? "eager" : "lazy"}
                  fetchpriority={index === 0 ? "high" : "auto"}
                  decoding="async"
                />
                <PhotoCaption />
              </div>

              <div class="p-6">
                <h2 class="font-bold text-lg text-navy-900 mb-4 truncate">
                  {project.title}
                </h2>

                <div class="space-y-2 mb-6">
                  <div class="flex justify-between text-sm border-b border-stone-200 pb-2">
                    <span class="text-slate-500">Pow. użytkowa:</span>
                    <span class="font-medium text-navy-900">
                      {project.size}
                    </span>
                  </div>
                  <div class="flex justify-between text-sm border-b border-stone-200 pb-2">
                    <span class="text-slate-500">Ilość pokoi (P/S):</span>
                    <span class="font-medium text-navy-900">
                      {project.rooms}
                    </span>
                  </div>
                  <div class="flex justify-between text-sm border-b border-stone-200 pb-2">
                    <span class="text-slate-500">Łazienki:</span>
                    <span class="font-medium text-navy-900">
                      {project.bathrooms}
                    </span>
                  </div>
                </div>

                <a
                  href="/#kontakt"
                  class="block w-full text-center py-2.5 bg-white border border-navy-900 text-navy-900 rounded-lg hover:bg-navy-900 hover:text-white transition-colors text-sm font-medium"
                >
                  Wycena budowy tego projektu
                </a>
              </div>
            </div>
          ))
        }
      </div>
    </Container>
  </main>
  <Footer />
</Layout>
